# Puerto del servidor local de Centinela
PORT=3000

# Interfaz de escucha. Por defecto solo esta máquina (127.0.0.1)
HOST=127.0.0.1

# (Opcional) Nombres de host adicionales permitidos, separados por comas
ALLOWED_HOSTS=

# Servidor MCP oficial de MyInvestor + GPTadvisor (activo por defecto)
MYINVESTOR_MCP_URL=https://mcp.myinvestor.es/mcp

# (Opcional) Clave de API de Anthropic para usar Claude Vision / Sonnet en vivo
# Si se deja vacío, Centinela usa su extractor determinista integrado (100% funcional en demo)
ANTHROPIC_API_KEY=
# (Opcional) Modelo de Claude. claude-sonnet-4-20250514 se retiró el 15-jun-2026 y ya no responde.
ANTHROPIC_MODEL=claude-sonnet-5-5
# (Opcional) Modelo para analizar llamadas y SMS. claude-haiku-5-5 es unas 15 veces más barato, pero en la
# medición fuera de muestra acertó 23/27 frente a 26/27 de Sonnet, con la misma latencia (ver README).
ANTHROPIC_CALL_MODEL=claude-sonnet-5-5
# (Opcional) Tope de peticiones a Claude por arranque del servidor. Al llegar, la app sigue solo con reglas.
CLAUDE_MAX_CALLS=300

# (Opcional) Clave de API de ElevenLabs para la voz (TTS), la transcripción (Scribe) y el micrófono en vivo
# Si se deja vacío, Centinela usa síntesis de voz nativa en español de baja latencia
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# (Opcional) Voz del estafador en el modo escenario (/escenario.html). Debe ser distinta de la anterior.
ELEVENLABS_SCAMMER_VOICE_ID=pNInz6obpgDQGcFmaJgB
# (Opcional) Tope de créditos estimados de ElevenLabs por arranque. Al llegar: voz y reconocimiento del navegador.
ELEVENLABS_MAX_CREDITS=3000
# (Opcional) on = genera voz nueva · cache_only = solo lo ya generado (ensayos sin gasto) · off = voz del navegador
ELEVENLABS_TTS=on
ELEVENLABS_STT=on
# (Opcional) Modelos de voz: respuestas dinámicas (0,5 créditos/carácter) y frases precacheadas (1 crédito/carácter)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_MODEL_PRECACHE=eleven_multilingual_v2
